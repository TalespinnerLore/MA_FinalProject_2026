[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D initial_palette;
uniform sampler2D new_palette;
uniform int colors_count;



void fragment() {
	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(TEXTURE, UV);


// IntParameter:6
	int n_out6p0 = colors_count;


	vec4 n_out7p0;
// Expression:7
	n_out7p0 = vec4(0.0, 0.0, 0.0, 0.0);
	{
		 vec2 new_uv = vec2(0,0);
		
		for (int i = 0; i < n_out6p0; i++) {
			float u = (float(i)+0.5) / float(n_out6p0);
			float v = 0.5;
			vec2 uv = vec2(u,v);
			vec4 initial_palette_color = texture(initial_palette, uv);
			float dist = distance(n_out3p0, initial_palette_color);
			
			if (dist == 0.0) {
				new_uv = uv;
				break;
			}
		}
		
		n_out7p0 = texture(new_palette, new_uv);
	}


// Output:0
	COLOR.rgb = vec3(n_out7p0.xyz);


}
