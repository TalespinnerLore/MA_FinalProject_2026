; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TowerOfTrials_Test"
run/main_scene="res://Scenes/StaticLevels/HubScene_Playtesting.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Global="*res://Utility/global.gd"
DungeonData="*res://Utility/DungeonData.gd"
PlayerStats="*res://Utility/Player_Stats.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="viewport"

[file_customization]

folder_colors={
"res://Art/": "purple",
"res://Crafting/": "yellow",
"res://Objects/": "orange",
"res://Resources/": "teal",
"res://Scenes/": "green",
"res://Sounds/": "blue",
"res://UI/": "yellow",
"res://Units/": "red",
"res://Utility/": "gray"
}

[global_group]

draganddrop="objects that can be dragged and dropped"
dropzone="zone where draganddrop items can be placed"
Player=""
TILEMAP=""
ENVIRONMENT_OBJECT_MANAGER=""
UNIT_MANAGER=""
NAVIGATION_MANAGER=""
DIALOGUE_MANAGER=""
Yes_No_UI=""

