; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TowerOfTrials_prototype1_5"
run/main_scene="res://UI/PlaytestUI/Main_Menu_UI.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Global="*res://Utility/global.gd"
DungeonData="*res://Utility/DungeonData.gd"
PlayerStats="*res://Utility/Player_Stats.gd"
SaveLoad="*res://_SaveLoad/SaveLoad.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=2
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_resource_groups/plugin.cfg")

[file_customization]

folder_colors={
"res://Art/": "purple",
"res://Crafting/": "yellow",
"res://Objects/": "orange",
"res://Resources/": "teal",
"res://Scenes/": "green",
"res://Sounds/": "blue",
"res://UI/": "yellow",
"res://Units/": "red",
"res://Utility/": "gray"
}

[global_group]

draganddrop="objects that can be dragged and dropped"
dropzone="zone where draganddrop items can be placed"
Player=""
TILEMAP=""
ENVIRONMENT_OBJECT_MANAGER=""
UNIT_MANAGER=""
NAVIGATION_MANAGER=""
DIALOGUE_MANAGER=""
Yes_No_UI=""
VFX_container=""
ITEM_MANAGER=""
SFX_PLAYER=""
crafting=""
TOWER_PORTAL=""
tower_area=""
classswap_area=""
CLASS_SWAP=""
HUB_WORLD=""
BANK_UI=""
STRONGBOXSHOP_UI=""
ABILITY_SELECTOR_UI=""
SHOP_UI_POTION=""
SHOP_UI_GEAR=""
SHOP_UI_TILES=""
MUSIC=""

[godot_resource_groups]

auto_rebuild=true

